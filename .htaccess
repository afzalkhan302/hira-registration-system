# ---------------------------------------------------------------------------
# Nothing outside the site itself may be fetched over HTTP.
# ---------------------------------------------------------------------------
Options -Indexes

# The credentials file, the schema, and anything starting with a dot.
<FilesMatch "^\.env|\.sql$|\.md$">
    Require all denied
</FilesMatch>

<FilesMatch "^\.">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
