# Copy this file to ".env" and fill in your own values.
# .env is listed in .gitignore and must never be committed.

# ---- Database ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=hira_registration
DB_USER=root
DB_PASS=

# ---- Staff sign-in ----
# The username typed on the login page.
ADMIN_USER=admin
#
# The password is never stored -- only this bcrypt hash of it. Generate one with:
#   php bin/set-admin-password.php "the password you want"
# then paste the printed line here. The example below is the word "changeme";
# replace it before the site goes anywhere near the internet.
ADMIN_PASS_HASH=$2y$10$8kJZ7Yy6mE1Q2vJ8Zt0O0eB5nZ0Q7Xh1mLQ3o6a0X9pQ4tW2y1sMi

# ---- Optional ----
# Only needed if the pages are hosted on a different domain from this API.
# Comma-separated, no trailing slash. Leave empty for same-origin hosting.
ALLOWED_ORIGINS=

# Set to true only while debugging; it lets error text reach the browser.
APP_DEBUG=false
