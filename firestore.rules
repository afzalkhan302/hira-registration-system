rules_version = '2';

// HIRA course-registration Firestore rules.
//
// - The public may CREATE one application at a time, and nothing else. They can
//   never read, list, edit or delete applications — not even their own.
// - The office (the signed-in admin account) may read, update and delete.
//
// Replace ADMIN_EMAIL_PLACEHOLDER below with the e-mail of the admin account you
// create under Authentication → Users. It must match ADMIN_EMAIL in
// assets/js/firebase-config.js. (Hardening option: switch to a custom claim —
// see the notes at the bottom.)

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'ADMIN_EMAIL_PLACEHOLDER';
    }

    function isValidNewApplication(d) {
      return d.status == 'New'
        && d.createdAt == request.time
        && d.updatedAt == request.time
        && d.fullName is string      && d.fullName.size()      >= 3 && d.fullName.size()      <= 150
        && d.fatherName is string    && d.fatherName.size()    >= 3 && d.fatherName.size()    <= 150
        && d.dob is string           && d.dob.size()           <= 10
        && d.gender in ['Male', 'Female']
        && d.mobile is string        && d.mobile.size()        >= 5  && d.mobile.size()       <= 20
        && d.address is string       && d.address.size()       >= 5  && d.address.size()      <= 300
        && d.qualification is string && d.qualification.size() >= 1  && d.qualification.size() <= 120
        && d.course in ['DIT', 'Web Development', 'Pharmacy']
        && d.whatsapp is string      && d.whatsapp.size()      <= 20
        && d.email is string         && d.email.size()         <= 150
        && d.knowledge is string     && d.knowledge.size()     <= 60
        && d.message is string       && d.message.size()       <= 800
        && d.note == ''
        && (d.photoPath == null || (d.photoPath is string && d.photoPath.size() <= 200));
    }

    match /applications/{applicationId} {
      allow read:   if isAdmin();
      allow create: if isValidNewApplication(request.resource.data);
      allow update: if isAdmin()
                    && request.resource.data.status in ['New', 'Contacted', 'Approved', 'Rejected'];
      allow delete: if isAdmin();
    }

    // Nothing else is accessible.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

// -----------------------------------------------------------------------------
// Hardening option (recommended for production): instead of matching an e-mail,
// give the admin account a custom claim and check it here:
//
//   function isAdmin() { return request.auth != null && request.auth.token.admin == true; }
//
// Set the claim once with the Admin SDK, e.g. in a Node script:
//   admin.auth().setCustomUserClaims(uid, { admin: true })
// -----------------------------------------------------------------------------
