# Copy to server/.env and fill in. Never commit .env.

# Where the API listens.
PORT=5000

# MongoDB connection string.
#  - Local:  mongodb://127.0.0.1:27017/hira_registration
#  - Atlas:  mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/hira_registration
MONGODB_URI=mongodb://127.0.0.1:27017/hira_registration

# Secret used to sign admin JWTs. Use a long random string.
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=8h

# The office (admin) account. Used ONCE by `npm run seed` to create the admin
# document with a bcrypt-hashed password. The plain password is never stored.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-strong-password

# Comma-separated list of allowed frontend origins (CORS).
# Local dev (Vite) + your deployed frontend, e.g.:
#   http://localhost:5173,https://your-app.vercel.app
CORS_ORIGINS=http://localhost:5173
